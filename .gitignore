 # Byte-compiled / optimized / DLL files
    __pycache__/
    *.py[cod]
    *$py.class
    *.so

    # Jupyter Notebook checkpoints
    .ipynb_checkpoints/
    */.ipynb_checkpoints/*

    # Virtual Environments
    venv/
    .venv/
    env/
    ENV/

    # IDE & Editor files
    .vscode/
    .idea/
    *.swp
    *.swo

    # OS generated files
    .DS_Store
    Thumbs.db
    desktop.ini

    # Temporary interactive map outputs
    *.html
    !ui/assets/*.html

    # Streamlit local config & cache
    .streamlit/secrets.toml